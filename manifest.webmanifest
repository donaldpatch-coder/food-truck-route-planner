  "lang": "en",
  "icons": [
    {"src": "/assets/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/assets/app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/assets/app-icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Find food", "url": "/#find"},
    {"name": "Sales log", "url": "/app?screen=checkins"},
    {"name": "Route plan", "url": "/app?screen=plan"}
  ]
}
