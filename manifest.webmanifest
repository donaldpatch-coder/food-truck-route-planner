{
  "id": "/street-bite-app",
  "name": "The Street Bite",
  "short_name": "Street Bite",
  "description": "Food truck routes, check-ins, sales, local food and business tools.",
  "start_url": "/app?source=installed",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f5ec",
